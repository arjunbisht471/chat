# WebSocket signaling URL. Leave unset when frontend and backend share a host.
# VITE_WS_URL=wss://perfactchat.com

# Comma-separated STUN URLs.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN should include UDP, TCP, and TLS fallbacks. Obtain real credentials from
# coturn or a managed provider; never commit production credentials.
VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
VITE_TURN_USERNAME=replace-with-turn-username
VITE_TURN_CREDENTIAL=replace-with-turn-password

# Use "relay" temporarily to verify TURN; use "all" in production normally.
VITE_ICE_TRANSPORT_POLICY=all
